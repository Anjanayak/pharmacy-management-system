# Copy this file to ".env" (in the same folder as docker-compose.yml) and fill
# in your own values. ".env" is gitignored — it will never be committed.
#
# Leaving GROQ_API_KEY blank (or not creating a .env file at all) keeps the
# app on the offline, rule-based AI layer with zero external API calls —
# this is the default and requires no setup.
#
# To enable the real-LLM AI layer for prescription parsing and drug
# interaction checks, get a free API key from https://console.groq.com
# (API Keys section) and set it below.

GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
AI_PROVIDER=rule_based
